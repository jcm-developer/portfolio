---
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import Section from '../../components/Section.astro';
import { certifications, profile, projectMedia } from '../../data/profile';
import { getDictionary, LOCALES, type Locale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Builds one home page per locale.
 *
 * @return The route params for `/en/` and `/es/`.
 */
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = getDictionary(locale);

/** The last segment of a profile URL, shown as the handle under each channel. */
const handleOf = (url: string) => new URL(url).pathname.split('/').filter(Boolean).pop() ?? '';

const contacts = [
  { icon: 'mail', label: t.contact.email, handle: profile.email, href: `mailto:${profile.email}`, external: false },
  { icon: 'linkedin', label: 'LinkedIn', handle: handleOf(profile.linkedin), href: profile.linkedin, external: true },
  { icon: 'github', label: 'GitHub', handle: handleOf(profile.github), href: profile.github, external: true },
] as const;
---

<BaseLayout locale={locale}>
  <Hero locale={locale} />

  <Section id="about" label={t.nav.about}>
    <p class="about" data-words>{t.about.body}</p>
  </Section>

  <Section id="experience" label={t.nav.experience}>
    {
      t.experience.map((job) => (
        <article class="stage" data-reveal>
          <p class="entry-period">{job.period}</p>
          <h3 class="entry-title">{job.role}</h3>
          <p class="entry-sub">{job.company}</p>
          <ul class="entry-bullets">
            {job.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </Section>

  <Section id="projects" label={t.nav.projects}>
    {
      t.projects.map((project) => {
        const media = projectMedia[project.slug];
        return (
          <article class="stage project" data-reveal>
            <div class="project-text">
              <p class="entry-period">{project.period}</p>
              <h3 class="entry-title">{project.name}</h3>
              <p class="entry-text">{project.description}</p>
              <ul class="tags">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <details class="project-more">
                <summary>{t.projectsUi.more}</summary>
                <p>{project.body}</p>
              </details>
              {media?.url && (
                <a class="project-link" href={media.url} target="_blank" rel="noopener noreferrer">
                  {t.projectsUi.visit} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
            {media && (
              <div class:list={['project-plate', `project-plate-${media.kind ?? 'logo'}`]}>
                <img src={media.image} alt="" width="800" height="450" loading="lazy" decoding="async" />
              </div>
            )}
          </article>
        );
      })
    }
  </Section>

  <Section id="skills" label={t.nav.skills}>
    <ul class="skills" data-stagger>
      {t.skills.map((skill) => <li data-reveal>{skill}</li>)}
    </ul>
  </Section>

  <Section id="education" label={t.nav.education}>
    {
      t.education.studies.map((study) => (
        <article class="stage" data-reveal>
          <p class="entry-period">{study.year}</p>
          <h3 class="entry-title">{study.title}</h3>
          <p class="entry-sub">{study.school}</p>
        </article>
      ))
    }

    <div class="extra" data-reveal>
      <h3 class="extra-title">{t.education.languagesLabel}</h3>
      <ul class="tags">
        {t.education.languages.map((language) => <li>{language}</li>)}
      </ul>
    </div>

    <div class="extra">
      <div data-reveal>
        <h3 class="extra-title">{t.education.certificationsLabel}</h3>
        <p class="extra-hint">{t.education.certificationsHint}</p>
      </div>
      <ul class="certs" data-stagger>
        {
          certifications.map((cert) => (
            <li data-reveal>
              <a href={cert.url} target="_blank" rel="noopener noreferrer">
                <span class="certs-name">{cert.name}</span>
                <span class="certs-meta">
                  {cert.issuer} · {cert.year}
                </span>
                <span class="certs-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="contact" label={t.nav.contact} tone="tint">
    <div class="contact">
      <div class="contact-intro">
        <p class="contact-heading mask" data-reveal><span>{t.contact.heading}</span></p>
        <p class="contact-lead" data-reveal>{t.contact.lead}</p>
      </div>
      <ul class="contact-list" data-stagger>
        {
          contacts.map((channel) => (
            <li data-reveal>
              <a
                class:list={['contact-row', { 'contact-row-primary': channel.icon === 'mail' }]}
                href={channel.href}
                {...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="contact-icon">
                  <Icon name={channel.icon} size={20} />
                </span>
                <span class="contact-text">
                  <span class="contact-channel">{channel.label}</span>
                  <span class="contact-handle">{channel.handle}</span>
                </span>
                <span class="contact-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ── About: one statement that lights up word by word ── */

  .about {
    max-width: 42ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.3;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  /* ── Projects: the text, and the logo or screenshot on a plate to its right ── */

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  /* Every picture gets the same frame, so logos of different sizes and styles read as one set. */
  .project-plate {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    margin-top: 1.75rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: #fff;
    overflow: hidden;
    transition: border-color 400ms ease;
  }

  .project-plate-logo {
    padding: 1rem 1.25rem;
  }

  .project-plate img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Grey at rest so no brand colour competes with the page; full colour on hover. */
    filter: grayscale(1);
    opacity: 0.75;
    transition:
      filter 500ms ease,
      opacity 500ms ease,
      scale 700ms var(--ease);
  }

  .project-plate-screenshot img {
    object-fit: cover;
  }

  .project:hover .project-plate {
    border-color: var(--indigo);
  }

  .project:hover .project-plate img {
    filter: none;
    opacity: 1;
    scale: 1.04;
  }

  .project-more {
    max-width: 62ch;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .project-more summary {
    width: fit-content;
    font-weight: 500;
    color: var(--indigo-deep);
    cursor: pointer;
  }

  .project-more p {
    margin-top: 0.75rem;
  }

  .project-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 500;
  }

  .project-link span {
    display: inline-block;
    transition: translate 300ms var(--ease);
  }

  .project-link:hover span {
    translate: 0.15rem -0.15rem;
  }

  /* ── Skills: rows that slide on hover ── */

  .skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 3rem);
  }

  .skills li {
    padding-block: 1.125rem 0.875rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.2;
    transition:
      color 300ms ease,
      padding 400ms var(--ease);
  }

  .skills li:hover {
    padding-left: 0.625rem;
    color: var(--indigo-deep);
  }

  /* ── Education: languages and certificates ── */

  .extra {
    margin-top: clamp(3rem, 6vw, 4rem);
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--rule);
  }

  .extra-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .extra-hint {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .certs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .certs li {
    display: flex;
  }

  .certs a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
    padding: 0.875rem 2.75rem 0.875rem 1.125rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    line-height: 1.35;
    text-decoration: none;
    transition:
      border-color 200ms ease,
      translate 400ms var(--ease);
  }

  .certs a:hover {
    border-color: var(--indigo);
    translate: 0 -0.1875rem;
  }

  .certs-name {
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .certs-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .certs-arrow {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    color: var(--indigo);
    transition: translate 300ms var(--ease);
  }

  .certs a:hover .certs-arrow {
    translate: 0.15rem -0.15rem;
  }

  /* ── Contact ── */

  /* ── Contact: the invitation on the left, one card per channel on the right ── */

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .contact-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.75rem, 6vw, 4.75rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .contact-lead {
    max-width: 28ch;
    margin-top: 1.25rem;
    text-wrap: balance;
    font-size: clamp(1.0625rem, 1.6vw, 1.1875rem);
    color: var(--ink-soft);
  }

  .contact-list {
    display: grid;
    gap: 0.75rem;
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem 1rem 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
    text-decoration: none;
    transition:
      border-color 200ms ease,
      box-shadow 400ms ease,
      translate 400ms var(--ease);
  }

  .contact-row:hover {
    border-color: var(--indigo);
    box-shadow: 0 18px 40px -26px rgb(61 50 181 / 0.55);
    translate: 0 -0.1875rem;
  }

  .contact-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--tint);
    color: var(--indigo-deep);
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  .contact-row-primary .contact-icon,
  .contact-row:hover .contact-icon {
    background: var(--indigo);
    color: #fff;
  }

  .contact-text {
    display: grid;
    flex: 1;
    gap: 0.125rem;
    min-width: 0;
  }

  .contact-channel {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .contact-handle {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .contact-arrow {
    flex: none;
    color: var(--indigo);
    transition: translate 300ms var(--ease);
  }

  .contact-row:hover .contact-arrow {
    translate: 0.15rem -0.15rem;
  }

  /* Under the section breakpoint the invitation sits above the cards. */
  @media (max-width: 52rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }

  /* Touch screens never hover, so there the pictures show in colour from the start. */
  @media (hover: none) {
    .project-plate img {
      filter: none;
      opacity: 1;
    }
  }

  @media (max-width: 44rem) {
    .project {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    /* The picture follows the text, at the column's width, so the title leads each project. */
    .project-plate {
      margin-top: 0;
    }

    .project-plate-logo {
      padding: 1.5rem 2rem;
    }

    .skills,
    .certs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
