---
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import { certifications, profile, projectMedia } from '../../data/profile';
import { getDictionary, LOCALES, type Locale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

/**
 * Builds one home page per locale.
 *
 * @return The route params for `/en/` and `/es/`.
 */
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = getDictionary(locale);
---

<BaseLayout locale={locale}>
  <Hero locale={locale} />

  <Section id="about" label={t.nav.about}>
    <p class="about" data-words>{t.about.body}</p>
  </Section>

  <Section id="experience" label={t.nav.experience}>
    {
      t.experience.map((job) => (
        <article class="stage" data-reveal>
          <p class="entry-period">{job.period}</p>
          <h3 class="entry-title">{job.role}</h3>
          <p class="entry-sub">{job.company}</p>
          <ul class="entry-bullets">
            {job.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </Section>

  <Section id="projects" label={t.nav.projects}>
    {
      t.projects.map((project) => {
        const media = projectMedia[project.slug];
        return (
          <article class="stage" data-reveal>
            <p class="entry-period">{project.period}</p>
            <h3 class="entry-title">{project.name}</h3>
            <p class="entry-text">{project.description}</p>
            <ul class="tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <details class="project-more">
              <summary>{t.projectsUi.more}</summary>
              <p>{project.body}</p>
            </details>
            {media?.url && (
              <a class="project-link" href={media.url} target="_blank" rel="noopener noreferrer">
                {t.projectsUi.visit} <span aria-hidden="true">↗</span>
              </a>
            )}
          </article>
        );
      })
    }
  </Section>

  <Section id="skills" label={t.nav.skills}>
    <ul class="skills" data-stagger>
      {t.skills.map((skill) => <li data-reveal>{skill}</li>)}
    </ul>
  </Section>

  <Section id="education" label={t.nav.education}>
    {
      t.education.studies.map((study) => (
        <article class="stage" data-reveal>
          <p class="entry-period">{study.year}</p>
          <h3 class="entry-title">{study.title}</h3>
          <p class="entry-sub">{study.school}</p>
        </article>
      ))
    }

    <div class="extra" data-reveal>
      <h3 class="extra-title">{t.education.languagesLabel}</h3>
      <ul class="tags">
        {t.education.languages.map((language) => <li>{language}</li>)}
      </ul>
    </div>

    <div class="extra">
      <div data-reveal>
        <h3 class="extra-title">{t.education.certificationsLabel}</h3>
        <p class="extra-hint">{t.education.certificationsHint}</p>
      </div>
      <ul class="certs" data-stagger>
        {
          certifications.map((cert) => (
            <li data-reveal>
              <a href={cert.url} target="_blank" rel="noopener noreferrer">
                <span class="certs-name">{cert.name}</span>
                <span class="certs-meta">
                  {cert.issuer} · {cert.year}
                </span>
                <span class="certs-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="contact" label={t.nav.contact} tone="tint">
    <p class="contact-heading mask" data-reveal><span>{t.contact.heading}</span></p>
    <p class="contact-lead" data-reveal>{t.contact.lead}</p>
    <a class="contact-email" href={`mailto:${profile.email}`} data-reveal>{profile.email}</a>
    <ul class="contact-links" data-reveal>
      <li><a class="button button-primary" href={`mailto:${profile.email}`}>{t.contact.email}</a></li>
      <li><a class="button" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a class="button" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a class="button" href={profile.cv[locale]} download>{t.contact.cv}</a></li>
    </ul>
  </Section>
</BaseLayout>

<style>
  /* ── About: one statement that lights up word by word ── */

  .about {
    max-width: 42ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.3;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  /* ── Projects ── */

  .project-more {
    max-width: 62ch;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .project-more summary {
    width: fit-content;
    font-weight: 500;
    color: var(--indigo-deep);
    cursor: pointer;
  }

  .project-more p {
    margin-top: 0.75rem;
  }

  .project-link {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 500;
  }

  .project-link span {
    display: inline-block;
    transition: translate 300ms var(--ease);
  }

  .project-link:hover span {
    translate: 0.15rem -0.15rem;
  }

  /* ── Skills: rows that slide on hover ── */

  .skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 3rem);
  }

  .skills li {
    padding-block: 1.125rem 0.875rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    line-height: 1.2;
    transition:
      color 300ms ease,
      padding 400ms var(--ease);
  }

  .skills li:hover {
    padding-left: 0.625rem;
    color: var(--indigo-deep);
  }

  /* ── Education: languages and certificates ── */

  .extra {
    margin-top: clamp(3rem, 6vw, 4rem);
    padding-top: clamp(2rem, 4vw, 2.75rem);
    border-top: 1px solid var(--rule);
  }

  .extra-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .extra-hint {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .certs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .certs li {
    display: flex;
  }

  .certs a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
    padding: 0.875rem 2.75rem 0.875rem 1.125rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    line-height: 1.35;
    text-decoration: none;
    transition:
      border-color 200ms ease,
      translate 400ms var(--ease);
  }

  .certs a:hover {
    border-color: var(--indigo);
    translate: 0 -0.1875rem;
  }

  .certs-name {
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .certs-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .certs-arrow {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    color: var(--indigo);
    transition: translate 300ms var(--ease);
  }

  .certs a:hover .certs-arrow {
    translate: 0.15rem -0.15rem;
  }

  /* ── Contact ── */

  .contact-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .contact-lead {
    margin-top: 1.75rem;
    color: var(--ink-soft);
  }

  .contact-email {
    display: inline-block;
    margin-top: 0.375rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.25rem, 3.4vw, 2.25rem);
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  @media (max-width: 44rem) {
    .skills,
    .certs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
