---
import '@fontsource-variable/league-spartan';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto-mono/latin-400.css';
import '../styles/global.css';

import Chat from '../components/Chat.astro';
import Nav from '../components/Nav.astro';
import { profile } from '../data/profile';
import { getDictionary, LOCALES, type Locale } from '../i18n';

/**
 * Wraps every page: document head, top bar, footer, the assistant and the scroll motion.
 *
 * @param locale - The locale of the page.
 * @param title - The document title; defaults to the site title.
 * @param description - The meta description; defaults to the site description.
 * @param indexable - False for pages search engines should skip, such as the 404.
 */
interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  indexable?: boolean;
}

const { locale, indexable = true } = Astro.props;
const t = getDictionary(locale);
const { title = t.meta.title, description = t.meta.description } = Astro.props;

const site = Astro.site ?? Astro.url;
const canonical = new URL(`/${locale}/`, site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: t.role,
  email: `mailto:${profile.email}`,
  url: canonical,
  sameAs: [profile.linkedin, profile.github],
  worksFor: { '@type': 'Organization', name: t.experience[0].company },
  address: { '@type': 'PostalAddress', addressLocality: 'Valencia', addressCountry: 'ES' },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f1fa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {
      indexable ? (
        <>
          <link rel="canonical" href={canonical} />
          {LOCALES.map((code) => (
            <link rel="alternate" hreflang={code} href={new URL(`/${code}/`, site).href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
          <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <a class="skip" href="#main">{t.nav.skipToContent}</a>
    <Nav locale={locale} />
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <p class="wrap footer-inner">© {new Date().getFullYear()} {profile.name}</p>
    </footer>
    <Chat locale={locale} />
  </body>
</html>

<script>
  import '../scripts/motion';
</script>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 40;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
  }

  .skip:focus {
    top: 0.75rem;
  }

  .footer {
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .footer-inner {
    padding-block: 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-align: center;
  }
</style>
