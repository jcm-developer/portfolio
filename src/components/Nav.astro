---
import { profile } from '../data/profile';
import { getDictionary, LOCALES, SECTIONS, type Locale } from '../i18n';
import Mark from './Mark.astro';

/**
 * Renders the sticky top bar: home link, section links with the one in view marked, the
 * language switch, and a bar along the bottom that fills as the page scrolls.
 *
 * @param locale - The locale of the current page.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
---

<header class="nav">
  <div class="wrap nav-inner">
    <a class="nav-home" href={`/${locale}/`}>
      <Mark size={18} />
      <span>{profile.name}</span>
    </a>

    <nav class="nav-links" aria-label={t.nav.menu}>
      <ul>
        {
          SECTIONS.map((section) => (
            <li>
              <a href={`#${section}`} data-nav-section={section}>
                {t.nav[section]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="nav-langs">
      {
        LOCALES.map((code) => (
          <li>
            <a
              href={`/${code}/`}
              hreflang={code}
              lang={code}
              aria-current={code === locale ? 'true' : undefined}
              aria-label={code === locale ? undefined : t.nav.switchLanguage}
            >
              {code.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <span class="nav-progress" aria-hidden="true"></span>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--tint) 86%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--nav-height);
  }

  .nav-home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-home span {
    /* League Spartan sits high in its line box; nudge it onto the mark's centre. */
    padding-top: 0.2em;
  }

  .nav-links {
    margin-left: auto;
    min-width: 0;
  }

  .nav-links ul {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    position: relative;
    display: block;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 300ms ease;
  }

  .nav-links a:hover {
    color: var(--indigo-deep);
  }

  /* The link of the section in view, set by src/scripts/motion.ts. */
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.125rem;
    height: 1px;
    background: var(--indigo);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms var(--ease);
  }

  .nav-links a:global(.is-active) {
    color: var(--ink);
  }

  .nav-links a:global(.is-active)::after {
    transform: scaleX(1);
  }

  /* Fills with --scroll, which the same script keeps on the root element. */
  .nav-progress {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: var(--indigo);
    transform: scaleX(var(--scroll, 0));
    transform-origin: left;
  }

  .nav-langs {
    display: flex;
    gap: 0.125rem;
    padding: 0.1875rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
  }

  .nav-langs a {
    display: block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .nav-langs a[aria-current] {
    background: var(--indigo);
    color: #fff;
  }

  @media (max-width: 52rem) {
    .nav-inner {
      flex-wrap: wrap;
      gap: 0 1rem;
      padding-block: 0.625rem 0;
    }

    .nav-langs {
      margin-left: auto;
    }

    /* The section links drop to their own row and scroll sideways. */
    .nav-links {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav-links ul {
      gap: 1.25rem;
      padding-block: 0.625rem;
    }
  }
</style>
