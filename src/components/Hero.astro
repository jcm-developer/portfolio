---
import { profile } from '../data/profile';
import { getDictionary, type Locale } from '../i18n';
import Icon from './Icon.astro';
import Mark from './Mark.astro';

/**
 * Renders the opening block, one screen tall: the name, the one-line pitch, the question box
 * that hands the visitor to the assistant and the CV download, stacked in one column on the
 * left, with the animated ribbon from the LinkedIn banner filling the space on the right (a
 * band under the copy on phones).
 *
 * @param locale - The locale of the current page.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const [firstName, ...lastName] = profile.name.split(' ');
---

<section class="hero">
  <canvas class="hero-ribbon" data-ribbon aria-hidden="true"></canvas>

  <div class="wrap hero-inner">
    <p class="label hero-role">
      <span>{t.role}</span>{' '}<span aria-hidden="true">·</span>{' '}<span>{t.location}</span>
    </p>
    <h1 class="hero-name">
      <span class="visually-hidden">{profile.name}</span>
      <span class="mask hero-line" aria-hidden="true"><span>{firstName}</span></span>
      <span class="mask hero-line" aria-hidden="true">
        <span>{lastName.join(' ')}<span class="hero-dot">.</span></span>
      </span>
    </h1>

    <div class="hero-foot">
      <p class="hero-lead">{t.hero.lead}</p>

      <form class="ask" data-ask-form>
        <label class="ask-label" for="ask-input">
          <Mark size={14} />
          {t.hero.askLabel}
        </label>
        <div class="ask-field">
          <input
            id="ask-input"
            name="question"
            type="text"
            maxlength="500"
            autocomplete="off"
            placeholder={t.hero.askPlaceholder}
          />
          <button class="button button-primary" type="submit">{t.hero.askSubmit}</button>
        </div>
      </form>

      <a class="hero-cv" href={profile.cv[locale]} download>
        <Icon name="download" size={18} />
        {t.hero.cv}
      </a>
    </div>
  </div>
</section>

<script>
  import '../scripts/ribbon';
</script>

<style>
  /* One screen tall, capped so very tall windows do not leave the copy floating. */
  .hero {
    position: relative;
    display: grid;
    align-content: center;
    min-height: min(calc(100svh - var(--nav-height)), 56rem);
    overflow: hidden;
    background: var(--tint);
    border-bottom: 1px solid var(--rule);
  }

  .hero-ribbon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .hero-role {
    animation: hero-fade 900ms var(--ease) both;
  }

  /* Role and location wrap as whole units, never mid-phrase. */
  .hero-role > span {
    white-space: nowrap;
  }

  .hero-name {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.25rem, 10vw, 7.5rem);
    line-height: 0.86;
    letter-spacing: -0.05em;
  }

  .hero-line {
    width: fit-content;
    padding-right: 0.08em;
  }

  /* Each line rises from behind its own edge, the second a beat after the first. */
  .hero-line > span {
    transform-origin: left bottom;
    animation: hero-rise 1200ms var(--ease) 100ms both;
  }

  .hero-line + .hero-line > span {
    animation-delay: 240ms;
  }

  .hero-dot {
    color: var(--indigo);
  }

  /* Pitch and question box follow the name in the same column, so the eye runs straight down. */
  .hero-foot {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.25rem);
    max-width: 34rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .hero-lead {
    max-width: 30ch;
    font-size: clamp(1.1875rem, 2vw, 1.5rem);
    line-height: 1.45;
    color: var(--ink-soft);
    animation: hero-fade 900ms var(--ease) 650ms both;
  }

  .ask {
    animation: hero-fade 900ms var(--ease) 800ms both;
  }

  .ask-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.625rem;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .ask-label :global(.mark) {
    animation: hero-spin 10s linear infinite;
  }

  .ask-field {
    display: flex;
    gap: 0.375rem;
    padding: 0.375rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    box-shadow: 0 18px 44px -22px rgb(61 50 181 / 0.5);
    transition:
      border-color 160ms ease,
      box-shadow 300ms ease;
  }

  .ask-field:focus-within {
    border-color: var(--indigo);
    box-shadow:
      0 0 0 0.3rem color-mix(in srgb, var(--indigo) 14%, transparent),
      0 18px 44px -22px rgb(61 50 181 / 0.5);
  }

  .ask-field input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.25rem 0.5rem 1rem;
    border: 0;
    background: transparent;
  }

  .ask-field input:focus {
    outline: none;
  }

  .ask-field input::placeholder {
    color: var(--ink-soft);
    opacity: 0.75;
  }

  .hero-cv {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin-top: calc(-1 * clamp(0.5rem, 1.5vw, 0.75rem));
    font-weight: 500;
    font-size: 0.9375rem;
    color: var(--indigo-deep);
    text-decoration: none;
    animation: hero-fade 900ms var(--ease) 950ms both;
  }

  .hero-cv:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .hero-cv :global(.icon) {
    transition: translate 300ms var(--ease);
  }

  .hero-cv:hover :global(.icon) {
    translate: 0 0.125rem;
  }

  /* Phones: the copy sits at the top and the ribbon becomes a band under it, so the lines never
     run behind the text. The canvas height matches the room left by the padding. */
  @media (max-width: 44rem) {
    .hero {
      align-content: start;
      min-height: 0;
    }

    .hero-inner {
      padding-block: 2.5rem 11rem;
    }

    .hero-ribbon {
      top: auto;
      height: 10rem;
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(112%) rotate(4deg);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @keyframes hero-spin {
    to {
      rotate: 360deg;
    }
  }

  /* A loop would restart every instant under the global reduced-motion rule. */
  @media (prefers-reduced-motion: reduce) {
    .ask-label :global(.mark) {
      animation: none;
    }
  }
</style>
