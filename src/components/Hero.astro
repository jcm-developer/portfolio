---
import { profile } from '../data/profile';
import { getDictionary, type Locale } from '../i18n';
import Icon from './Icon.astro';
import Mark from './Mark.astro';

/**
 * Renders the opening block, one screen tall: the role, the name, the one-line pitch and two
 * actions (open the assistant, download the CV), stacked in one column on the left, with the
 * animated ribbon from the LinkedIn banner filling the space on the right (a band along the
 * bottom on phones).
 *
 * @param locale - The locale of the current page.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const [firstName, ...lastName] = profile.name.split(' ');
---

<section class="hero">
  <canvas class="hero-ribbon" data-ribbon aria-hidden="true"></canvas>

  <div class="wrap hero-inner">
    <p class="label hero-role">{t.role}</p>
    <h1 class="hero-name">
      <span class="visually-hidden">{profile.name}</span>
      <span class="mask hero-line" aria-hidden="true"><span>{firstName}</span></span>
      <span class="mask hero-line" aria-hidden="true">
        <span>{lastName.join(' ')}<span class="hero-dot">.</span></span>
      </span>
    </h1>

    <p class="hero-lead">{t.hero.lead}</p>

    <div class="hero-actions">
      <button class="button button-primary hero-action" type="button" data-chat-trigger aria-controls="chat-panel">
        <Mark size={16} />
        {t.hero.ask}
      </button>
      <a class="button hero-action" href={profile.cv[locale]} download>
        <Icon name="download" size={18} />
        {t.hero.cv}
      </a>
    </div>
  </div>
</section>

<script>
  import '../scripts/ribbon';
</script>

<style>
  /* One screen tall, capped so very tall windows do not leave the copy floating. */
  .hero {
    position: relative;
    display: grid;
    align-content: center;
    min-height: min(calc(100svh - var(--nav-height)), 56rem);
    overflow: hidden;
    background: var(--tint);
    border-bottom: 1px solid var(--rule);
  }

  .hero-ribbon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .hero-role {
    animation: hero-fade 900ms var(--ease) both;
  }

  .hero-name {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.25rem, 10vw, 7.5rem);
    line-height: 0.86;
    letter-spacing: -0.05em;
  }

  .hero-line {
    width: fit-content;
    padding-right: 0.08em;
  }

  /* Each line rises from behind its own edge, the second a beat after the first. */
  .hero-line > span {
    transform-origin: left bottom;
    animation: hero-rise 1200ms var(--ease) 100ms both;
  }

  .hero-line + .hero-line > span {
    animation-delay: 240ms;
  }

  .hero-dot {
    color: var(--indigo);
  }

  .hero-lead {
    max-width: 30ch;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    font-size: clamp(1.1875rem, 2vw, 1.5rem);
    line-height: 1.45;
    color: var(--ink-soft);
    animation: hero-fade 900ms var(--ease) 650ms both;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 2.5rem);
    animation: hero-fade 900ms var(--ease) 800ms both;
  }

  .hero-action {
    justify-content: center;
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
  }

  .button-primary.hero-action {
    box-shadow: 0 18px 44px -20px rgb(61 50 181 / 0.6);
  }

  /* The outline button sits on the tint and the ribbon; a paper fill keeps it legible. */
  .hero-action:not(.button-primary) {
    background: var(--paper);
  }

  .hero-action:not(.button-primary):hover {
    background: var(--ink);
  }

  /* The mark is indigo by default; on the indigo button it takes the button's white. */
  .hero-action :global(.mark) {
    color: currentColor;
    transition: rotate 500ms var(--ease);
  }

  .hero-action:hover :global(.mark) {
    rotate: 30deg;
  }

  /* Phones: still one screen tall, but the ribbon becomes a band along the bottom and the copy
     is centred in the space above it, so the lines never run behind the text. */
  @media (max-width: 44rem) {
    .hero {
      --band: clamp(8rem, 24svh, 13rem);
      min-height: calc(100svh - var(--nav-height));
    }

    .hero-inner {
      padding-block: 2rem calc(var(--band) + 1rem);
    }

    .hero-ribbon {
      top: auto;
      height: var(--band);
    }

    .hero-name {
      margin-top: 1rem;
      font-size: clamp(3.5rem, 19vw, 5.5rem);
    }

    .hero-lead {
      margin-top: 1.5rem;
    }

    .hero-actions {
      display: grid;
      margin-top: 2rem;
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(112%) rotate(4deg);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>
