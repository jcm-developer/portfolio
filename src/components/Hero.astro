---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import { profile } from '../data/profile';
import { getDictionary, type Locale } from '../i18n';

/**
 * Renders the opening block: name, one-line pitch and the question box that hands the
 * visitor to the assistant, over the animated ribbon from the LinkedIn banner.
 *
 * @param locale - The locale of the current page.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const [firstName, ...lastName] = profile.name.split(' ');
---

<section class="hero">
  <canvas class="hero-ribbon" data-ribbon aria-hidden="true"></canvas>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="label hero-role">{t.role} · {t.location}</p>
      <h1 class="hero-name">
        <span>{firstName}</span>
        <span>{lastName.join(' ')}</span>
      </h1>
      <p class="hero-lead">{t.hero.lead}</p>

      <form class="ask" data-ask-form>
        <label class="ask-label" for="ask-input">{t.hero.askLabel}</label>
        <div class="ask-field">
          <input
            id="ask-input"
            name="question"
            type="text"
            maxlength="500"
            autocomplete="off"
            placeholder={t.hero.askPlaceholder}
          />
          <button class="button button-primary" type="submit">{t.hero.askSubmit}</button>
        </div>
        <ul class="ask-chips">
          {
            t.hero.chips.map((chip) => (
              <li>
                <button type="button" data-ask-chip>
                  {chip}
                </button>
              </li>
            ))
          }
        </ul>
      </form>
    </div>

    <Image
      class="hero-photo"
      src={avatar}
      alt={t.hero.photoAlt}
      width={640}
      height={640}
      widths={[320, 640]}
      sizes="(max-width: 52rem) 9rem, 20rem"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<script>
  import '../scripts/ribbon';
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--tint);
    border-bottom: 1px solid var(--rule);
  }

  /* Kept to the right of the copy so the lines never run through the text. */
  .hero-ribbon {
    position: absolute;
    top: 0;
    right: 0;
    width: 60%;
    height: 100%;
    pointer-events: none;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(3.5rem, 10vw, 7.5rem);
  }

  .hero-copy > * {
    animation: rise 700ms var(--ease) both;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: 80ms;
  }

  .hero-copy > :nth-child(3) {
    animation-delay: 160ms;
  }

  .hero-copy > :nth-child(4) {
    animation-delay: 240ms;
  }

  .hero-name {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.75rem, 13vw, 9rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
  }

  .hero-name span {
    display: block;
  }

  .hero-lead {
    max-width: 30ch;
    margin-top: 1.5rem;
    font-size: clamp(1.1875rem, 2.2vw, 1.5rem);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .ask {
    max-width: 34rem;
    margin-top: 2.5rem;
  }

  .ask-label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .ask-field {
    display: flex;
    gap: 0.375rem;
    padding: 0.375rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper);
    box-shadow: 0 12px 32px -18px rgb(61 50 181 / 0.45);
    transition: border-color 160ms ease;
  }

  .ask-field:focus-within {
    border-color: var(--indigo);
  }

  .ask-field input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.25rem 0.5rem 1rem;
    border: 0;
    background: transparent;
  }

  .ask-field input:focus {
    outline: none;
  }

  .ask-field input::placeholder {
    color: var(--ink-soft);
    opacity: 0.75;
  }

  .ask-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }

  .ask-chips button {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 70%, transparent);
    font-size: 0.8125rem;
    color: var(--ink-soft);
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease;
  }

  .ask-chips button:hover {
    border-color: var(--indigo);
    color: var(--indigo-deep);
  }

  .hero-photo {
    width: clamp(14rem, 26vw, 20rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 0.5rem solid var(--paper);
    border-radius: 50%;
    box-shadow: 0 24px 60px -30px rgb(61 50 181 / 0.55);
    animation: rise 900ms var(--ease) 200ms both;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }

  @media (max-width: 52rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-ribbon {
      width: 100%;
      height: 17rem;
    }

    .hero-photo {
      order: -1;
      width: 9rem;
      border-width: 0.375rem;
    }
  }
</style>
