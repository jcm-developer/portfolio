---
import { getDictionary, type Locale } from '../i18n';
import Mark from './Mark.astro';

/**
 * Renders the assistant: a launcher button and the panel it opens.
 *
 * The panel only talks to this site's own `/api/chat`; no key or prompt reaches the page.
 * Behaviour lives in `src/scripts/chat.ts`, which reads its strings from the data
 * attributes set here.
 *
 * @param locale - The locale of the current page.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).chat;
---

<div
  class="chat"
  data-chat
  data-lang={locale}
  data-going-to={t.goingTo}
  data-went-there={t.wentThere}
  data-error-busy={t.errorBusy}
  data-error-offline={t.errorOffline}
  data-error-generic={t.errorGeneric}
>
  <button class="chat-launcher" type="button" data-chat-open aria-expanded="false" aria-controls="chat-panel">
    <Mark size={22} />
    <span class="visually-hidden">{t.open}</span>
  </button>

  <section id="chat-panel" class="chat-panel" aria-labelledby="chat-title" hidden>
    <header class="chat-head">
      <div>
        <h2 id="chat-title" class="chat-title">{t.title}</h2>
        <p class="chat-subtitle">{t.subtitle}</p>
      </div>
      <button class="chat-close" type="button" data-chat-close aria-label={t.close}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </header>

    <div class="chat-log" data-chat-log role="log" aria-live="polite">
      <p class="chat-msg chat-msg-bot">{t.greeting}</p>
    </div>

    <form class="chat-form" data-chat-form>
      <label class="visually-hidden" for="chat-input">{t.placeholder}</label>
      <input id="chat-input" name="question" type="text" maxlength="500" autocomplete="off" placeholder={t.placeholder} />
      <button class="chat-send" type="submit" aria-label={t.send}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </button>
    </form>
    <p class="chat-note">{t.disclaimer}</p>
  </section>
</div>

<script>
  import '../scripts/chat';
</script>

<!-- Global on purpose: the script creates message elements that scoped styles would miss. -->
<style is:global>
  .chat-launcher {
    position: fixed;
    right: var(--gutter);
    bottom: 1.5rem;
    z-index: 30;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 0;
    border-radius: 50%;
    background: var(--indigo);
    box-shadow: 0 14px 32px -12px rgb(61 50 181 / 0.7);
    cursor: pointer;
    transition:
      background-color 160ms ease,
      transform 200ms var(--ease);
  }

  .chat-launcher .mark {
    color: #fff;
  }

  .chat-launcher:hover {
    background: var(--indigo-deep);
    transform: rotate(30deg);
  }

  .chat-launcher[aria-expanded='true'] {
    display: none;
  }

  .chat-panel {
    position: fixed;
    right: var(--gutter);
    bottom: 1.5rem;
    z-index: 30;
    display: flex;
    flex-direction: column;
    width: min(24rem, calc(100vw - 2 * var(--gutter)));
    height: min(34rem, calc(100dvh - 6rem));
    border: 1px solid var(--rule);
    border-radius: 1.25rem;
    background: var(--paper);
    box-shadow: 0 32px 80px -32px rgb(22 21 31 / 0.45);
    overflow: hidden;
    animation: chat-in 280ms var(--ease);
  }

  .chat-panel[hidden] {
    display: none;
  }

  @keyframes chat-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.98);
    }
  }

  .chat-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.875rem 1.25rem;
    background: var(--tint);
    border-bottom: 1px solid var(--rule);
  }

  .chat-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  .chat-subtitle {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .chat-close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }

  .chat-close:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .chat-log {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .chat-msg {
    max-width: 88%;
    padding: 0.625rem 0.875rem;
    border-radius: 1rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .chat-msg-bot {
    align-self: flex-start;
    border-bottom-left-radius: 0.25rem;
    background: var(--tint);
  }

  .chat-msg-user {
    align-self: flex-end;
    border-bottom-right-radius: 0.25rem;
    background: var(--indigo);
    color: #fff;
  }

  .chat-msg-error {
    align-self: stretch;
    max-width: none;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink-soft);
  }

  /* The note left when the assistant scrolls the page. */
  .chat-msg-nav {
    align-self: flex-start;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--indigo-deep);
  }

  .chat-msg-pending::after {
    content: '···';
    letter-spacing: 0.2em;
    animation: chat-pulse 1.1s ease-in-out infinite;
  }

  @keyframes chat-pulse {
    50% {
      opacity: 0.3;
    }
  }

  .chat-form {
    display: flex;
    gap: 0.375rem;
    margin: 0 1rem;
    padding: 0.3125rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    transition: border-color 160ms ease;
  }

  .chat-form:focus-within {
    border-color: var(--indigo);
  }

  .chat-form input {
    flex: 1;
    min-width: 0;
    padding: 0.375rem 0.25rem 0.375rem 0.875rem;
    border: 0;
    background: transparent;
    font-size: 0.9375rem;
  }

  .chat-form input:focus {
    outline: none;
  }

  .chat-send {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 0;
    border-radius: 50%;
    background: var(--indigo);
    color: #fff;
    cursor: pointer;
  }

  .chat-send:hover {
    background: var(--indigo-deep);
  }

  .chat-send:disabled {
    background: var(--rule);
    cursor: default;
  }

  .chat-note {
    padding: 0.5rem 1.25rem 0.75rem;
    font-size: 0.6875rem;
    text-align: center;
    color: var(--ink-soft);
  }

  @media (max-width: 36rem) {
    /* A bottom sheet, so the page the assistant scrolls stays visible above it. */
    .chat-panel {
      right: 0;
      bottom: 0;
      width: 100%;
      height: min(30rem, 62dvh);
      border-radius: 1.25rem 1.25rem 0 0;
      border-inline: 0;
      border-bottom: 0;
    }
  }
</style>
