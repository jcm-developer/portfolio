{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name chosen in the Cloudflare dashboard.
  "name": "portfolio",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // Per-visitor limit for /api/chat: 8 requests per minute, keyed by IP.
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  // Branch previews (every branch but main) get their own limiter namespace, so preview traffic
  // never shares a counter with production. Wrangler refuses a preview without this block.
  "previews": {
    "ratelimits": [
      {
        "name": "CHAT_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 8, "period": 60 }
      }
    ]
  }
  // OPENAI_API_KEY is a secret: set it in the dashboard, never here.
}
